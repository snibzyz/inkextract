# ============================================================
# User data — ห้าม commit เนื้อหา (อาจมีลิขสิทธิ์) แต่เก็บโครงสร้างโฟลเดอร์ไว้
# ============================================================
workspace/**
!workspace/
!workspace/*/
!workspace/**/
!workspace/**/.gitkeep

# User projects (multi-project mode) — ทั้งหมดเป็นข้อมูลผู้ใช้ ไม่ commit
projects/

# Playwright visual audit output — regenerated โดย _audit_ui.py ทุกครั้ง
_screenshots/

# Reflex POC (อยู่ใน branch poc/reflex เท่านั้น — ไม่ commit ใน main)
_poc_reflex/

# Portable bundle (สร้างจากสคริปต์ build — ไม่ commit ของหนัก)
bundle/
python.tar.gz
python-embed*.zip
*.spec

# ============================================================
# Local environment / build artifacts
# ============================================================
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
.pytest_cache/
.mypy_cache/

# ============================================================
# User-specific config (template ให้ก็พอ — ไม่อัพ user state)
# ============================================================
.config/settings.json
.config/user_preferences.json
.config/novel_list.txt
.config/ocr_settings.json
.config/projects.json
.config/app.log
.config/.migration_*
.config/install_root.txt
.config/update_check_cache.json
# .config/exclude.txt → keep (default template)

# ============================================================
# IDE / editor state
# ============================================================
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ============================================================
# Temp / scratch files
# ============================================================
.tmp_*
*.tmp
*.log
