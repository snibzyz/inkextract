#!/usr/bin/env bash
set -e

cd "$(dirname "$0")"

if [ ! -f ".venv/bin/activate" ]; then
    echo "[X] ยังไม่ได้ติดตั้ง"
    echo
    echo "กรุณาดับเบิลคลิกไฟล์  ติดตั้ง.command  ก่อน"
    echo
    read -n 1 -s -r -p "กดปุ่มใดก็ได้เพื่อปิดหน้าต่าง..."
    exit 1
fi

echo "============================================================"
echo "           เครื่องมือตรวจสอบคำแปลนิยาย"
echo "============================================================"
echo "กำลังเปิดโปรแกรม..."
echo "เมื่อขึ้นข้อความเสร็จแล้ว ให้รอเบราว์เซอร์เปิดอัตโนมัติ"
echo "(ถ้าเบราว์เซอร์ไม่เปิดเอง ให้คัดลอก URL ที่ขึ้นมาไปเปิดเอง)"
echo
echo "ปิดโปรแกรม: กด Ctrl+C ในหน้าต่างนี้ หรือปิดหน้าต่าง"
echo "============================================================"
echo

# shellcheck disable=SC1091
source .venv/bin/activate
streamlit run .app/app.py
